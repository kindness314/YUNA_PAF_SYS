# 复制为 server/.env（或注入进程环境）。前缀 YUNA_。

# 开发用 SQLite；生产用 PostgreSQL：
# YUNA_DATABASE_URL=postgresql+psycopg://yuna:yuna@localhost:5432/yuna
YUNA_DATABASE_URL=sqlite:///./dev.db
YUNA_REDIS_URL=redis://localhost:6379/0

# 生产必须改为 32+ 字节随机串
YUNA_JWT_SECRET=change-me-to-a-long-random-secret-0123456789

YUNA_AUTO_CREATE_DB=true
YUNA_SEED_ADMIN_USERNAME=admin
YUNA_SEED_ADMIN_PASSWORD=admin123456
